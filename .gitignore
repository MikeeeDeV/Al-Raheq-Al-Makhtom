# 1. Dependencies & Package Managers
node_modules/
.pnpm-store/
.yarn/
package-lock.json.bak

# 2. Production & Build Outputs
dist/
dist-ssr/
build/
out/
.output/
.vercel/
.turbo/
*.tsbuildinfo

# 3. Environment & Sensitive Credentials
.env
.env.*
!.env.example
*.pem
*.crt
*.key
*.p12

# 4. Cache & Temporary Runtime Directories
.cache/
.vite/
.eslintcache
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. IDEs, Editors & Tooling
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*.tmp
*.bak

# 6. Operating System Files
.DS_Store
.DS_Store?
._*
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.directory

# 7. Agent & Local Workspace Scratch Files
.gemini/
scratch/
